# Data is never committed: EICV, LFS, Census and DHS microdata are licensed to the individual
# researcher and may not be redistributed. All data lives in the Dropbox folder (paths.py).
interim-processing/

# Keep the directory skeleton so a fresh clone has somewhere to put data.
!.gitkeep
!**/.gitkeep

# Rendered figures, maps and tables are written to the Dropbox output/ folder,
# not the repo, so a coauthor who does not run the code still sees them. Nothing
# to ignore here - but archive/ holds a 26 MB frozen copy of a previous run.
archive/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.DS_Store

# Credentials - never commit
.gfw_api_key

# Run logs and the metadata the pipelines write between steps (logs/*.json, checks
# reports): regenerated on every run, kept on disk, never committed. The one exception is
# benchmark_old_stata.json: the old Stata outputs, recorded once, which 03_checks compares against.
**/logs/*
!**/logs/benchmark_old_stata.json

# Generated variable lists live in Dropbox output/variable-lists/ (info-scripts/).
data/processed/

# Written by each pipeline's 03_checks.py on every run, with that machine's paths.
**/stata_checks.do

# Rendered outputs belong in Dropbox (Rwanda - TRS/_archive/ or output/), not the repo.
_archive/
